<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/date_opera_ie"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/et_nume_operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nume_operator_ex_oltean_paul"
            android:inputType="textPersonName"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alege_opera_ia_spinner"
            android:layout_marginTop="12dp"/>

        <Spinner
            android:id="@+id/spinner_operatie"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tipul_opera_iei_radiogroup"
            android:layout_marginTop="12dp"/>

        <RadioGroup
            android:id="@+id/rg_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_ingineresc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ingineresc" />

            <RadioButton
                android:id="@+id/rb_digital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/digital_r" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/durat_n_ore_ratingbar"
            android:layout_marginTop="12dp"/>

        <RatingBar
            android:id="@+id/rating_durata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:stepSize="0.5"/>

        <Switch
            android:id="@+id/switch_completata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/opera_ie_completat"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"/>

        <CheckBox
            android:id="@+id/cb_confirmare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/confirm_acurate_ea_datelor"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btn_salvare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/salveaz_obiectul"
            android:layout_marginTop="24dp"/>

    </LinearLayout>
</ScrollView>